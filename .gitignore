# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment secrets (never commit; use OS keychain or CI secrets)
.env
.env.*
!.env.example

# Monorepo / build caches
.turbo
/target
*.tsbuildinfo

# Local Brain durable data + exports (durable user data; never committed)
*.sqlite
*.sqlite-wal
*.sqlite-shm
/brain-data/
/exports/

# Generated Tauri sidecar binaries (built from source by scripts/build-sidecar.mjs)
apps/desktop/src-tauri/binaries/

# Generated by Tauri while compiling/checking permissions.
apps/desktop/src-tauri/gen/schemas/

# Claude Code session artifacts (shared hooks in settings.json stay tracked)
.claude/*
!.claude/settings.json

# fastembed default model cache (e2e test; model is downloaded on demand)
.fastembed_cache/
**/.fastembed_cache/
